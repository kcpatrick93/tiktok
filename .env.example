# TikTok API
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key

# Database
# Local dev: TURSO_DATABASE_URL=file:./data/dashboard.db
# Production: get URL + token from turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Login
DASHBOARD_PASSWORD=choose_a_password
SESSION_SECRET=generate_a_long_random_string

# Apify (source script discovery)
APIFY_TOKEN=your_apify_token
